import hxp.*;
import lime.tools.*;

class Project extends HXProject {

    static inline var GAME_VERSION:String = "0.0.2";
    static inline var GAME_ID:String      = "kareshi-project";
    static inline var MOD_API:String      = "0.0.2";

    public function new() {
        super();

        meta.title       = "Kareshi Project";
        meta.packageName = "com.kareshiproject.game";
        meta.version     = GAME_VERSION;
        meta.company     = "Kareshi Project Team";

        app.main = "Main";
        app.file = "KareshiProject";
        app.path = "export";

        window.width       = 1280;
        window.height      = 720;
        window.fps         = 60;
        window.background  = 0x000000;
        window.vsync       = true;
        window.resizable   = false;
        window.hardware    = true;
        window.antialiasing = 0;

        if (platformType == PlatformType.MOBILE) {
            window.fullscreen   = true;
            window.orientation  = Orientation.LANDSCAPE;
            window.resizable    = true;
            window.allowHighDPI = true;
        }

        if (platformType == PlatformType.DESKTOP) {
            window.allowHighDPI = true;
        }

        icons.push(new Icon("arts/icon.png"));

        sources.push("source");

        if (defines.get("targetType") == "cpp")
            haxelibs.push(new Haxelib("hxcpp"));
        haxelibs.push(new Haxelib("lime"));
        haxelibs.push(new Haxelib("openfl"));
        haxelibs.push(new Haxelib("flixel"));
        haxelibs.push(new Haxelib("flixel-ui"));
        haxelibs.push(new Haxelib("flixel-addons"));
        haxelibs.push(new Haxelib("hscript"));
        haxelibs.push(new Haxelib("polymod"));

        if (target == Platform.ANDROID)
            haxelibs.push(new Haxelib("extension-androidtools"));

        if (platformType == PlatformType.DESKTOP)
            haxelibs.push(new Haxelib("hxdiscord_rpc"));

        if (debug && defines.get("targetType") == "cpp")
            haxelibs.push(new Haxelib("hxcpp-debug-server"));

        includeAssets("assets/images", "images", ["*"]);
        includeAssets("assets/sounds", "sounds", ["*"]);
        includeAssets("assets/music",  "music",  ["*"]);
        includeAssets("assets/data",   "data",   ["*"]);
        includeAssets("assets/fonts",  "fonts",  ["*"]);
        includeAssets("assets/videos", "videos", ["*"]);

        if (platformType == PlatformType.DESKTOP)
            includeAssets("mods", "mods", ["*"]);

        haxedefs.set("GAME_VERSION",              GAME_VERSION);
        haxedefs.set("GAME_ID",                   GAME_ID);
        haxedefs.set("MOD_API",                   MOD_API);

        haxedefs.set("POLYMOD_USE_LIME",          "1");
        haxedefs.set("POLYMOD_APPEND_FOLDER_INDEX_TO_ASSET_LIBRARY", "1");
        haxedefs.set("POLYMOD_MOD_ROOT",          "mods");
        haxedefs.set("HSCRIPT_ALLOWED_IMPORTS",   "1");

        if (debug) {
            haxedefs.set("BUILD_DEBUG",              "1");
            haxedefs.set("POLYMOD_DEBUG",            "1");
            haxedefs.set("FLX_NO_FOCUS_LOST_SCREEN", "1");
            haxeflags.push("-debug");
        } else {
            haxedefs.set("BUILD_RELEASE", "1");
            haxeflags.push("-dce full");
            haxeflags.push("--no-traces");
        }

        if (targetFlags.exists("final")) {
            haxedefs.set("BUILD_FINAL", "1");
        }

        if (platformType == PlatformType.MOBILE) {
            haxedefs.set("FLX_NO_MOUSE",    "1");
            haxedefs.set("FLX_NO_KEYBOARD", "1");
            haxedefs.set("FLX_TOUCH",       "1");
        } else if (platformType == PlatformType.DESKTOP) {
            haxedefs.set("POLYMOD_MODS_ENABLED", "1");
        }

        if (target == Platform.HTML5) {
            haxedefs.set("FLX_NO_NATIVE_CURSOR", "1");
        }

        haxeflags.push("-D haxe4");
        haxeflags.push("-D analyzer-optimize");

        setupAndroid();
        setupIOS();
        setupDesktop();
        setupHTML5();
    }

    function setupAndroid():Void {
        if (target != Platform.ANDROID) return;

        config.set("android.minimum-sdk-version", 21);
        config.set("android.target-sdk-version", 35);

        config.push("android.permission", "android.permission.VIBRATE");
        config.push("android.permission", "android.permission.INTERNET");
        config.push("android.permission", "android.permission.ACCESS_NETWORK_STATE");
        config.push("android.permission", "android.permission.READ_EXTERNAL_STORAGE");
        config.push("android.permission", "android.permission.WAKE_LOCK");

        if (debug) {
            config.push("android.permission", "android.permission.READ_LOGS");
        }

        var keystorePath = Sys.getEnv("ANDROID_KEYSTORE_PATH");
        if (keystorePath != null && keystorePath != "") {
            keystore = new Keystore(
                keystorePath,
                Sys.getEnv("ANDROID_KEYSTORE_PASSWORD"),
                Sys.getEnv("ANDROID_KEYSTORE_ALIAS"),
                Sys.getEnv("ANDROID_KEYSTORE_ALIAS_PASSWORD")
            );
        }
    }

    function setupIOS():Void {
        if (target != Platform.IOS) return;

        config.set("ios.deployment", 12.0);
        config.set("ios.device", "universal");
        // Custom App Transport Security settings require an iOS Info.plist template.
    }

    function setupDesktop():Void {
        if (platformType != PlatformType.DESKTOP) return;

        if (target == Platform.WINDOWS)
            haxedefs.set("windows.icon", "arts/icon.png");

        if (target == Platform.MAC)
            icons.push(new Icon("arts/icon.icns"));

        if (target == Platform.LINUX)
            haxedefs.set("linux.category", "Game");
    }

    function setupHTML5():Void {
        if (target != Platform.HTML5) return;

        window.background = 0x000000;
        haxedefs.set("web", "1");
    }
}

